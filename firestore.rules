rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'samimak7312@gmail.com' ||
        (exists(/databases/$(database)/documents/settings/admin) &&
         get(/databases/$(database)/documents/settings/admin).data.adminUid == request.auth.uid)
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /sellRequests/{requestId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if (
        !exists(/databases/$(database)/documents/settings/admin) ||
        isAdmin() ||
        isAuthenticated()
      );
    }

    match /shopSettings/{docId} {
      allow read: if true;
      allow write: if (
        !exists(/databases/$(database)/documents/settings/admin) ||
        isAdmin() ||
        isAuthenticated()
      );
    }
  }
}
